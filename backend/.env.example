# Optional. Copy this file to a new file named .env to turn these on.
# Without a key the app still works: answers are scored offline with keyword checks.

# Port the app runs on (default 5000)
PORT=5000

# Your Anthropic API key turns on AI scoring for interview answers
ANTHROPIC_API_KEY=

# Which model scores your answers (you can change it any time)
AI_MODEL=claude-sonnet-5-5
